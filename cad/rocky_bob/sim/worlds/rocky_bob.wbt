EXTERNPROTO "../protos/RockyBob.proto"
WorldInfo {
  basicTimeStep 4
  contactProperties [ ContactProperties { coulombFriction [ 0.9 ] } ]
}
Viewpoint { orientation -0.25 0.2 0.95 1.95 position 0.45 -1.2 0.8 }
TexturedBackground {}
TexturedBackgroundLight {}
RectangleArena { floorSize 8 8 }
Solid { translation -1.25 1.5 0.15 rotation 0 0 1 0.0000 children [ Shape { appearance PBRAppearance { baseColor 0.75 0.72 0.68 roughness 0.9 metalness 0 } geometry Box { size 2.5 0.06 0.3 } } ] name "wall_west" boundingObject Box { size 2.5 0.06 0.3 } }
