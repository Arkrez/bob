<?xml version="1.0"?>
<robot name="bob" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!-- CAD-derived axes, limits and masses are preliminary; validate against actual hardware. -->
  <link name="base_link"><visual><geometry><mesh filename="package://bob_description/meshes/base_link.stl"/></geometry></visual><inertial><mass value="1.0"/><inertia ixx="0.01" iyy="0.01" izz="0.01" ixy="0" ixz="0" iyz="0"/></inertial></link>
  <xacro:macro name="bob_leg" params="prefix a0 a1 a2 a3 d1 d2">
    <link name="${prefix}_mount"><visual><geometry><mesh filename="package://bob_description/meshes/${prefix}_part0.stl"/></geometry></visual><inertial><mass value="0.1"/><inertia ixx="0.001" iyy="0.001" izz="0.001" ixy="0" ixz="0" iyz="0"/></inertial></link>
    <joint name="${prefix}_mount_fixed" type="fixed"><parent link="base_link"/><child link="${prefix}_mount"/><origin xyz="0 0 0" rpy="0 0 0"/></joint>
    <link name="${prefix}_joint1_link"><visual><origin xyz="${a1}" rpy="0 0 0"/><geometry><mesh filename="package://bob_description/meshes/${prefix}_part1.stl"/></geometry></visual><inertial><mass value="0.2"/><inertia ixx="0.001" iyy="0.001" izz="0.001" ixy="0" ixz="0" iyz="0"/></inertial></link>
    <joint name="${prefix}_joint1" type="revolute"><parent link="${prefix}_mount"/><child link="${prefix}_joint1_link"/><origin xyz="${a0}" rpy="0 0 0"/><axis xyz="0 0 1"/><limit lower="-1.570796" upper="1.570796" effort="10" velocity="2.618"/></joint>
    <link name="${prefix}_joint2_link"><visual><origin xyz="${a2}" rpy="0 0 0"/><geometry><mesh filename="package://bob_description/meshes/${prefix}_part2.stl"/></geometry></visual><inertial><mass value="0.2"/><inertia ixx="0.001" iyy="0.001" izz="0.001" ixy="0" ixz="0" iyz="0"/></inertial></link>
    <joint name="${prefix}_joint2" type="revolute"><parent link="${prefix}_joint1_link"/><child link="${prefix}_joint2_link"/><origin xyz="${d1}" rpy="0 0 0"/><axis xyz="0 1 0"/><limit lower="-1.570796" upper="1.570796" effort="10" velocity="2.618"/></joint>
    <link name="${prefix}_joint3_link"><visual><origin xyz="${a3}" rpy="0 0 0"/><geometry><mesh filename="package://bob_description/meshes/${prefix}_part3.stl"/></geometry></visual><inertial><mass value="0.2"/><inertia ixx="0.001" iyy="0.001" izz="0.001" ixy="0" ixz="0" iyz="0"/></inertial></link>
    <joint name="${prefix}_joint3" type="revolute"><parent link="${prefix}_joint2_link"/><child link="${prefix}_joint3_link"/><origin xyz="${d2}" rpy="0 0 0"/><axis xyz="0 1 0"/><limit lower="-1.570796" upper="1.570796" effort="10" velocity="2.618"/></joint>
  </xacro:macro>
  <xacro:bob_leg prefix="leg0" a0="-0.137775 -0.086000 0.111950" a1="0.137775 0.086000 -0.111950" a2="0.244985 0.060036 -0.101200" a3="0.352195 0.093736 -0.101186" d1="-0.107210 0.025964 -0.010750" d2="-0.107210 -0.033700 -0.000014"/>
  <xacro:bob_leg prefix="leg1" a0="-0.139700 0.140000 0.111950" a1="0.139700 -0.140000 -0.111950" a2="0.246910 -0.165964 -0.101200" a3="0.354120 -0.132264 -0.101186" d1="-0.107210 0.025964 -0.010750" d2="-0.107210 -0.033700 -0.000014"/>
  <xacro:bob_leg prefix="leg2" a0="-0.010300 0.140000 0.111950" a1="0.010300 -0.140000 -0.111950" a2="-0.096910 -0.114036 -0.101200" a3="-0.204120 -0.147736 -0.101186" d1="0.107210 -0.025964 -0.010750" d2="0.107210 0.033700 -0.000014"/>
  <xacro:bob_leg prefix="leg3" a0="-0.010300 -0.086000 0.111950" a1="0.010300 0.086000 -0.111950" a2="-0.096910 0.111964 -0.101200" a3="-0.204120 0.078264 -0.101186" d1="0.107210 -0.025964 -0.010750" d2="0.107210 0.033700 -0.000014"/>
</robot>
